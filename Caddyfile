# Zeabur 會以環境變數 PORT 指定監聽埠，本機以 8080 為預設值
:{$PORT:8080} {
	root * /srv

	encode zstd gzip

	# 乾淨網址：/about 依序嘗試 /about、/about/index.html、/about.html
	try_files {path} {path}/index.html {path}.html

	file_server

	# 帶雜湊的資源可以長快取；其餘（HTML、乾淨網址）保持短快取以便隨時更新。
	# 用反向比對而非 *.html，否則 /about 這類乾淨網址會漏掉標頭。
	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"

	@documents not path /assets/*
	header @documents Cache-Control "public, max-age=0, must-revalidate"

	header {
		X-Content-Type-Options "nosniff"
		X-Frame-Options "SAMEORIGIN"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	handle_errors {
		@404 expression {err.status_code} == 404
		rewrite @404 /404.html
		file_server
	}

	log {
		output stdout
		format console
	}
}
